# Copia este archivo a `.env` (o usa User Secrets / variables de entorno reales) y completa
# los valores. NUNCA subas `.env` con credenciales reales al repositorio.
#
# En ASP.NET Core estas claves se leen como variables de entorno con "__" como separador de
# jerarquía (equivalente a ConnectionStrings:DefaultConnection en appsettings.json), o se
# configuran con `dotnet user-secrets set "Clave" "valor"` dentro de src/NpiManagement.Api.

# Cadena de conexión a SQL Server (Development normalmente usa LocalDB y no necesita esta
# variable — ver src/NpiManagement.Api/appsettings.Development.json). Requerida en cualquier
# otro entorno.
ConnectionStrings__DefaultConnection=Server=localhost;Database=NpiManagement;User Id=CAMBIA_ESTE_USUARIO;Password=CAMBIA_ESTA_CONTRASENA;TrustServerCertificate=True

# Contraseña única usada por el seed de Development para TODOS los usuarios semilla — OBLIGATORIA
# (el arranque en Development falla con un error claro si falta o si no cumple la política de
# Identity, en vez de generar o mostrar una contraseña). Debe tener 8+ caracteres, mayúscula,
# minúscula, dígito y carácter no alfanumérico (ej. "Demo#2026") — "12345678" NO sirve. Nunca la
# pongas en un archivo versionado: configúrala con
# `dotnet user-secrets set "Seed:UsersPassword" "<valor>"` dentro de src/NpiManagement.Api.
# Su valor nunca se registra en logs. Sólo tiene efecto cuando ASPNETCORE_ENVIRONMENT=Development.
Seed__UsersPassword=

# Emisor/audiencia/clave de firma JWT — OBLIGATORIOS, la app no arranca sin ellos (ver
# Program.cs). Igual que Seed:UsersPassword, se configuran con User Secrets, nunca en un archivo
# versionado ni en variables de entorno compartidas: `dotnet user-secrets set "Jwt:SigningKey" "..."`.
Jwt__Issuer=NpiManagement
Jwt__Audience=NpiManagement.Clients
Jwt__SigningKey=CAMBIA_ESTA_CLAVE_POR_UNA_ALEATORIA_DE_AL_MENOS_32_CARACTERES

# Aplicar migraciones pendientes automáticamente al arrancar — apagado por defecto (ver
# docs/demo-setup.md, que usa `dotnet ef database update` manual). Nunca se activa fuera de
# Development sin importar este valor (ver el chequeo doble en Program.cs).
Database__ApplyMigrationsOnStartup=false

# Almacenamiento local de adjuntos (Fase 6, ADR-021) — fuera del código fuente. En Development
# usa por defecto una carpeta bajo el directorio temporal del usuario si no se configura.
FileStorage__RootPath=C:\ProgramData\NpiManagement\attachments
FileStorage__MaxSizeBytes=10485760
# FileStorage__AllowedContentTypes__0=application/pdf
# FileStorage__AllowedContentTypes__1=image/jpeg
# FileStorage__AllowedContentTypes__2=image/png

# Orígenes de navegador autorizados a llamar la API (CORS, Fase 7). Vacío = ningún navegador
# puede llamarla (las llamadas server-to-server o desde herramientas como curl/Postman no pasan
# por CORS y no se ven afectadas). El frontend de desarrollo (Vite) corre en el puerto 8080.
Cors__AllowedOrigins__0=http://localhost:8080

# Auto-registro con aprobación. Sólo se aceptan solicitudes de alta de este dominio de correo; sin
# esta restricción el endpoint de registro queda abierto a cualquiera en internet. Por defecto
# bioflex.mx si no se configura.
Registration__AllowedEmailDomain=bioflex.mx

# Administrador inicial — el único bootstrap que SÍ corre en Producción. Necesario sólo en el
# primer arranque de un despliegue nuevo: sin un AdminTotal no hay quién apruebe las solicitudes
# de acceso. No hace nada si ya existe un AdminTotal. RETIRA estas dos variables después del
# primer arranque y cambia la contraseña al iniciar sesión.
# Bootstrap__AdminEmail=evelazquez@bioflex.mx
# Bootstrap__AdminPassword=
# Bootstrap__AdminFullName=Administrador

# ============================ Correo ============================
# Avisos por correo de los eventos accionables del workflow (asignaciones, "requiere cambios",
# "puedes registrar el PT", etc.). Con Enabled=false el sistema se comporta exactamente como antes
# de que existiera el correo: los avisos sólo aparecen en la campana de la app.
#
# Bioflex usa Direct Send: se entrega directo al MX del tenant de Microsoft 365 SIN autenticación.
# Funciona porque todos los destinatarios son del propio dominio y el remitente va sobre el
# subdominio npi.bioflex.mx, cuyo DMARC es sp=none (verificado el 2026-09-11: llega a Bandeja de
# entrada). Por eso UserName/Password se dejan vacíos — llenarlos haría que intente autenticarse
# y el servidor lo rechazaría.
Mail__Enabled=false
Mail__Host=bioflex-mx.mail.protection.outlook.com
Mail__Port=25
Mail__FromAddress=npi-noreply@npi.bioflex.mx
Mail__FromName=Sistema NPI - Bioflex
# Mail__UserName=
# Mail__Password=
# Mail__TimeoutSeconds=30

# Base del frontend para armar la liga al NPI dentro del correo. Sin esto el correo llega sin
# botón y obliga a entrar y buscar el NPI a mano.
Mail__FrontendBaseUrl=http://172.16.10.31:997

ASPNETCORE_ENVIRONMENT=Development
